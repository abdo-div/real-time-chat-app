extends _base

block content
  main.flex-1.flex.flex-col.items-center.justify-center.bg-main-bg.p-6
    .w-full.max-w-md.bg-surface-container.border.border-border-subtle.p-8.rounded-2xl.shadow-2xl
      .text-center.mb-6
        span.material-symbols-outlined.text-primary.block.mb-3(style="font-size:48px") group_add
        h1.text-2xl.font-bold.text-white.mb-2 Join SlackFlow Workspace
        p.text-sm.text-on-surface-variant Create your free account

      div.hidden.p-3.mb-4.rounded.border.border-error.text-error.text-sm(id="auth-error-alert", style="background:rgba(255,180,171,0.1)")

      form(id="signup-form")
        .mb-4
          label.block.text-sm.text-white.mb-2(for="username") Username
          input.w-full.rounded-lg.p-3.text-white.input-field(type="text", id="username", required=true, placeholder="john_doe")
        .mb-4
          label.block.text-sm.text-white.mb-2(for="email") Email Address
          input.w-full.rounded-lg.p-3.text-white.input-field(type="email", id="email", required=true, placeholder="john@example.com")
        .mb-4
          label.block.text-sm.text-white.mb-2(for="password") Password
          input.w-full.rounded-lg.p-3.text-white.input-field(type="password", id="password", required=true, placeholder="••••••••")
        .mb-6
          label.block.text-sm.text-white.mb-2(for="passwordConfirm") Confirm Password
          input.w-full.rounded-lg.p-3.text-white.input-field(type="password", id="passwordConfirm", required=true, placeholder="••••••••")
        button.w-full.py-3.rounded-lg.font-bold.mb-4.btn-primary(type="submit", id="signup-btn") Create Account

      .text-center.text-sm.text-on-surface-variant
        | Already have an account?&nbsp;
        a.text-primary.font-bold(href="/login") Sign In
