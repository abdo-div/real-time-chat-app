extends _base

block content
  main.flex-1.flex.flex-col.items-center.justify-center.bg-main-bg.p-6
    .w-full.max-w-md.bg-surface-container.border.border-border-subtle.p-8.rounded-2xl.shadow-2xl
      .text-center.mb-6
        h1.text-headline-lg.font-bold.text-primary.mb-2 Join SlackFlow Workspace
        p.text-body-md.text-on-surface-variant Create your free account

      div.hidden.p-3.mb-4.rounded.bg-error\/20.border.border-error.text-error.text-label-md(id="auth-error-alert")

      form(id="signup-form")
        .mb-4
          label.block.text-label-md.text-white.mb-2 Username
          input.w-full.bg-surface-container-low.border.border-border-subtle.rounded-lg.p-3.text-white.focus_outline-none.focus_ring-2.focus_ring-secondary-container(type="text", id="username", required=true, placeholder="john_doe")
        .mb-4
          label.block.text-label-md.text-white.mb-2 Email Address
          input.w-full.bg-surface-container-low.border.border-border-subtle.rounded-lg.p-3.text-white.focus_outline-none.focus_ring-2.focus_ring-secondary-container(type="email", id="email", required=true, placeholder="john@example.com")
        .mb-4
          label.block.text-label-md.text-white.mb-2 Password
          input.w-full.bg-surface-container-low.border.border-border-subtle.rounded-lg.p-3.text-white.focus_outline-none.focus_ring-2.focus_ring-secondary-container(type="password", id="password", required=true, placeholder="••••••••")
        .mb-6
          label.block.text-label-md.text-white.mb-2 Confirm Password
          input.w-full.bg-surface-container-low.border.border-border-subtle.rounded-lg.p-3.text-white.focus_outline-none.focus_ring-2.focus_ring-secondary-container(type="password", id="passwordConfirm", required=true, placeholder="••••••••")
        button.w-full.py-3.bg-primary-container.text-on-primary-container.font-bold.rounded-lg.hover_opacity-90.transition-opacity.mb-4(type="submit") Create Account

      .text-center.text-body-md.text-on-surface-variant
        span Already have an account? 
        a.text-primary.font-bold.hover_underline(href="/login") Sign In
