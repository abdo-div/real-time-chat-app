extends _base

block content
  main.flex-1.flex.flex-col.items-center.justify-center.bg-main-bg.p-6
    .w-full.max-w-md.bg-surface-container.border.border-border-subtle.p-8.rounded-2xl.shadow-2xl.text-center
      span.material-symbols-outlined.text-error.block.mb-4(style="font-size:48px") error
      h1.text-2xl.font-bold.text-error.mb-2 Oops! Something went wrong.
      p.text-sm.text-on-surface-variant.mb-8 #{msg || 'An unexpected error occurred. Please try again.'}
      a.px-6.py-3.rounded-lg.font-bold.inline-block.btn-primary(href="/") Back to Workspace
