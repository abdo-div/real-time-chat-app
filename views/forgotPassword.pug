extends _base

block content
  main.flex-1.flex.flex-col.items-center.justify-center.bg-main-bg.p-6
    .w-full.max-w-md.bg-surface-container.border.border-border-subtle.p-8.rounded-2xl.shadow-2xl
      .text-center.mb-6
        span.material-symbols-outlined.text-primary.block.mb-3(style="font-size:48px") lock_reset
        h1.text-2xl.font-bold.text-white.mb-2 Reset Your Password
        p.text-sm.text-on-surface-variant Enter your account email to receive a reset link

      div.hidden.p-3.mb-4.rounded.border.border-error.text-error.text-sm(id="forgot-alert", style="background:rgba(255,180,171,0.1)")
      div.hidden.p-3.mb-4.rounded.border.border-primary.text-primary.text-sm(id="forgot-success", style="background:rgba(121,217,178,0.1)")

      form(id="forgot-password-form")
        .mb-6
          label.block.text-sm.text-white.mb-2(for="forgot-email") Email Address
          input.w-full.rounded-lg.p-3.text-white.input-field(type="email", id="forgot-email", required=true, placeholder="name@work-email.com")
        button.w-full.py-3.rounded-lg.font-bold.btn-primary(type="submit") Send Reset Email

      .text-center.mt-4
        a.text-on-surface-variant.text-sm(href="/login") ← Back to Sign In
