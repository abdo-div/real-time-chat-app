extends _base

block content
  main.flex-1.flex.flex-col.items-center.justify-center.bg-main-bg.p-6
    .w-full.max-w-md.bg-surface-container.border.border-border-subtle.p-8.rounded-2xl.shadow-2xl
      .text-center.mb-6
        h1.text-headline-lg.font-bold.text-primary.mb-2 Reset Your Password
        p.text-body-md.text-on-surface-variant Enter your account email to receive a password reset link

      div.hidden.p-3.mb-4.rounded.bg-error\/20.border.border-error.text-error.text-label-md(id="forgot-alert")

      form(id="forgot-password-form")
        .mb-6
          label.block.text-label-md.text-white.mb-2 Email Address
          input.w-full.bg-surface-container-low.border.border-border-subtle.rounded-lg.p-3.text-white(type="email", id="forgot-email", required=true)
        button.w-full.py-3.bg-primary-container.text-on-primary-container.font-bold.rounded-lg(type="submit") Send Reset Email
