extends _base

block content
  main.flex-1.flex.flex-col.items-center.justify-center.bg-main-bg.p-6
    .w-full.max-w-md.bg-surface-container.border.border-border-subtle.p-8.rounded-2xl.shadow-2xl
      .text-center.mb-6
        h1.text-headline-lg.font-bold.text-primary.mb-2 Set New Password
        p.text-body-md.text-on-surface-variant Please choose a strong new password

      div.hidden.p-3.mb-4.rounded.bg-error\/20.border.border-error.text-error.text-label-md(id="reset-alert")

      form(id="reset-password-form", data-token=token)
        .mb-4
          label.block.text-label-md.text-white.mb-2 New Password
          input.w-full.bg-surface-container-low.border.border-border-subtle.rounded-lg.p-3.text-white(type="password", id="reset-password", required=true)
        .mb-6
          label.block.text-label-md.text-white.mb-2 Confirm New Password
          input.w-full.bg-surface-container-low.border.border-border-subtle.rounded-lg.p-3.text-white(type="password", id="reset-passwordConfirm", required=true)
        button.w-full.py-3.bg-primary-container.text-on-primary-container.font-bold.rounded-lg(type="submit") Reset Password
