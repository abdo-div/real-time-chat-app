extends _base

block content
  main.flex-1.flex.flex-col.items-center.justify-center.bg-main-bg.p-6
    .w-full.max-w-md.bg-surface-container.border.border-border-subtle.p-8.rounded-2xl.shadow-2xl
      .text-center.mb-6
        span.material-symbols-outlined.text-primary.block.mb-3(style="font-size:48px") key
        h1.text-2xl.font-bold.text-white.mb-2 Set New Password
        p.text-sm.text-on-surface-variant Please choose a strong new password

      div.hidden.p-3.mb-4.rounded.border.border-error.text-error.text-sm(id="reset-alert", style="background:rgba(255,180,171,0.1)")

      form(id="reset-password-form", data-token=token)
        .mb-4
          label.block.text-sm.text-white.mb-2(for="reset-password") New Password
          input.w-full.rounded-lg.p-3.text-white.input-field(type="password", id="reset-password", required=true, placeholder="••••••••")
        .mb-6
          label.block.text-sm.text-white.mb-2(for="reset-passwordConfirm") Confirm New Password
          input.w-full.rounded-lg.p-3.text-white.input-field(type="password", id="reset-passwordConfirm", required=true, placeholder="••••••••")
        button.w-full.py-3.rounded-lg.font-bold.btn-primary(type="submit") Reset Password

      .text-center.mt-4
        a.text-on-surface-variant.text-sm(href="/login") ← Back to Sign In
