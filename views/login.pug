extends _base

block content
  main.flex-1.flex.flex-col.items-center.justify-center.bg-main-bg.p-6
    .w-full.max-w-md.bg-surface-container.border.border-border-subtle.p-8.rounded-2xl.shadow-2xl
      .text-center.mb-6
        span.material-symbols-outlined.text-primary.block.mb-3(style="font-size:48px") chat
        h1.text-2xl.font-bold.text-white.mb-2 Sign In to SlackFlow
        p.text-sm.text-on-surface-variant Enter your details to access your workspace

      div.hidden.p-3.mb-4.rounded.border.border-error.text-error.text-sm(id="auth-error-alert", style="background:rgba(255,180,171,0.1)")

      form(id="login-form")
        .mb-4
          label.block.text-sm.text-white.mb-2(for="email") Email Address
          input.w-full.rounded-lg.p-3.text-white.input-field(type="email", id="email", required=true, placeholder="name@work-email.com")
        .mb-6
          label.block.text-sm.text-white.mb-2(for="password") Password
          input.w-full.rounded-lg.p-3.text-white.input-field(type="password", id="password", required=true, placeholder="••••••••")
        button.w-full.py-3.rounded-lg.font-bold.mb-4.btn-primary(type="submit", id="login-btn") Sign In

      .flex.items-center.my-4
        .flex-1.border-t.border-border-subtle
        span.px-3.text-xs.text-on-surface-variant OR
        .flex-1.border-t.border-border-subtle

      .text-center.text-sm.text-on-surface-variant
        a.text-on-surface-variant.text-xs.block.mb-4(href="/forgotPassword") Forgot password?
        | Don't have an account?&nbsp;
        a.text-primary.font-bold(href="/signup") Create account
