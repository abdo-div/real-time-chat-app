extends _base

block content
  main.flex-1.flex.flex-col.bg-main-bg.relative.min-w-0(data-room-id=room._id, data-room-slug=room.slug)
    //- Chat Header
    header.h-\[49px\].border-b.border-border-subtle.flex.items-center.justify-between.px-section-padding.shrink-0.bg-main-bg\/80.backdrop-blur-md.sticky.top-0.z-10
      .flex.items-center.gap-2.overflow-hidden
        span.material-symbols-outlined.text-on-surface-variant tag
        h1.text-headline-md.font-headline-md.text-text-primary.truncate #{room.name}
        button.flex.items-center.gap-1.px-2.py-0.5.hover_bg-surface-container-highest.rounded.text-on-surface-variant.transition-colors
          span.text-caption.font-bold #{roomMembers ? roomMembers.length : 1} members
          span.material-symbols-outlined.text-\[14px\] keyboard_arrow_down
      .flex.items-center.gap-4
        button.text-on-surface-variant.hover_text-white.transition-colors(id="toggle-info-btn")
          span.material-symbols-outlined info

    //- Message Feed Area
    .flex-1.overflow-y-auto.px-section-padding.pt-6.space-y-6.pb-4(id="message-feed")
      .relative.flex.items-center.py-4
        .flex-grow.border-t.border-border-subtle
        span.flex-shrink.mx-4.px-4.py-1.rounded-full.border.border-border-subtle.bg-surface-container.text-caption.font-bold.text-on-surface-variant Welcome to ##{room.name}!
        .flex-grow.border-t.border-border-subtle

      if messages && messages.length
        each msg in messages
          .flex.gap-4.group.message-hover(data-message-id=msg._id)
            .shrink-0.w-10.h-10.rounded-lg.bg-indigo-500.overflow-hidden.mt-1
              img.w-full.h-full.object-cover(src=(msg.sender && msg.sender.avatar) ? msg.sender.avatar : "/img/default.jpg", alt="avatar")
            .flex-1.min-w-0
              .flex.items-baseline.gap-2
                span.text-label-md.text-text-primary.hover_underline.cursor-pointer #{msg.sender ? msg.sender.username : 'User'}
                span.text-caption.text-text-timestamp #{new Date(msg.createdAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}
              .text-body-md.text-on-surface.mt-1.leading-relaxed #{msg.content}

              if msg.attachments && msg.attachments.length
                each att in msg.attachments
                  .mt-3.max-w-md.rounded-xl.overflow-hidden.border.border-border-subtle.bg-surface-container
                    img.w-full.max-h-60.object-cover(src=att.fileUrl, alt="attachment")

              if msg.reactions && msg.reactions.length
                .flex.flex-wrap.gap-1.5.mt-3
                  each react in msg.reactions
                    button.px-2.py-0.5.rounded-full.bg-secondary-container\/20.border.border-secondary-container.flex.items-center.gap-1.5
                      span.text-\[14px\] #{react.emoji}
                      span.text-label-sm.text-secondary.font-bold 1

            .message-actions.sticky.top-0.flex.items-center.gap-0.5.bg-surface-container-high.border.border-border-subtle.rounded-lg.p-0.5.shadow-xl.h-fit
              button.p-1.5.hover_bg-surface-container-highest.rounded.transition-colors.text-on-surface-variant.hover_text-white.btn-react(data-emoji="👍")
                span.material-symbols-outlined.text-\[18px\] thumb_up
              button.p-1.5.hover_bg-surface-container-highest.rounded.transition-colors.text-on-surface-variant.hover_text-white.btn-react(data-emoji="❤️")
                span.material-symbols-outlined.text-\[18px\] favorite
              button.p-1.5.hover_bg-surface-container-highest.rounded.transition-colors.text-on-surface-variant.hover_text-white.btn-react(data-emoji="🔥")
                span.material-symbols-outlined.text-\[18px\] local_fire_department

    //- Typing Indicator
    div.hidden.px-section-padding.py-1.text-caption.text-primary.font-bold(id="typing-indicator") someone is typing...

    //- Message Input Area
    footer.p-section-padding.shrink-0.bg-main-bg
      form(id="chat-form")
        .max-w-5xl.mx-auto.border.border-border-subtle.rounded-xl.bg-surface-container.overflow-hidden.shadow-2xl.focus-within_ring-2.focus-within_ring-secondary-container.transition-shadow
          .flex.flex-col
            textarea.w-full.bg-transparent.border-none.focus_ring-0.text-body-md.text-text-primary.p-4.resize-none.min-h-\[50px\].max-h-\[400px\].overflow-y-auto(id="message-input", placeholder=`Message #${room.name}`, rows="1")
            .flex.items-center.justify-between.px-3.py-2.bg-surface-container-high\/50
              .flex.items-center.gap-1
                label.p-2.hover_bg-surface-container-highest.rounded.text-on-surface-variant.transition-colors.cursor-pointer
                  span.material-symbols-outlined.text-\[20px\] attach_file
                  input.hidden(type="file", id="attachment-file-input")
                span.text-caption.text-on-surface-variant(id="file-name-preview")
              .flex.items-center.gap-2
                button.p-2.bg-primary-container.text-on-primary-container.rounded-lg.font-bold.transition-all(type="submit", id="send-btn")
                  span.material-symbols-outlined send
      .text-center.mt-2
        span.text-\[10px\].text-on-surface-variant.uppercase.tracking-tighter Enter to send • Real-time Socket Connected

  //- Right Info Sidebar
  aside.hidden.xl_flex.flex-col.w-\[300px\].bg-sidebar-bg.border-l.border-border-subtle.overflow-y-auto(id="info-sidebar")
    .h-\[49px\].border-b.border-border-subtle.flex.items-center.justify-between.px-4.shrink-0
      span.text-label-md.font-bold.text-text-primary Channel Details
    .p-6.space-y-6
      div
        h3.text-label-sm.uppercase.tracking-wider.text-on-surface-variant.font-bold.mb-2 Topic / Description
        p.text-body-md.text-on-surface #{room.description || 'No description provided.'}
      div
        h3.text-label-sm.uppercase.tracking-wider.text-on-surface-variant.font-bold.mb-3 Channel Members (#{roomMembers ? roomMembers.length : 0})
        .space-y-2
          if roomMembers && roomMembers.length
            each m in roomMembers
              if m.user
                .flex.items-center.gap-3.p-2.rounded.bg-surface-container
                  .w-6.h-6.rounded.bg-blue-500.overflow-hidden
                    img.w-full.h-full.object-cover(src=m.user.avatar || '/img/default.jpg', alt=m.user.username)
                  span.text-label-md.text-white #{m.user.username}
                  span.ml-auto.text-caption.text-primary.font-bold #{m.role}
